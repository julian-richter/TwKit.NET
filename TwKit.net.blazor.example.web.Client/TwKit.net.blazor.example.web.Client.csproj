<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <TwKitTailwindSources>..\TwKit.net.blazor.example.web</TwKitTailwindSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TwKit.net.blazor\TwKit.net.blazor.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <Import Project="..\TwKit.net.blazor\build\TwKit.net.targets"/>

</Project>
